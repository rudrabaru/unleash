# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Security
# Required outside ENVIRONMENT=development: a private key of at least 32 characters (e.g., openssl rand -hex 32)
SECRET_KEY=dev_secret_unleash_verification_key_change_in_prod
SESSION_EXPIRY_SECONDS=120

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Storage
DATABASE_URL=sqlite:///./unleash.db
UPLOAD_TEMP_DIR=./temp_uploads
MAX_UPLOAD_BYTES=26214400

# Deepfake model (these are read from the real environment, not from this file):
#   UNLEASH_XCEPTION_CHECKPOINT   path to the trained checkpoint (default: backend/checkpoints/xception_deepfake_best.pth)
#   UNLEASH_FAKE_THRESHOLD        fake-probability line, default 0.5
