# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Security
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY=dev_secret_unleash_verification_key_change_in_prod
SESSION_EXPIRY_SECONDS=120

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Storage
DATABASE_URL=sqlite:///./unleash.db
UPLOAD_TEMP_DIR=./temp_uploads
