# Where the Next dev server forwards /api/v1 (server-side only; see next.config.mjs).
API_ORIGIN=http://127.0.0.1:8000

# Optional. Leave unset to call the same-origin /api/v1 proxy above. Set an absolute URL only to
# bypass the proxy; the backend must then allow this site in CORS_ORIGINS.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
